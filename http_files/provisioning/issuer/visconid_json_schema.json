    "reference_id_type": {
      "type": "string"
    },
    "issuing_country": {
      "type": "string"
    },
    "given_name": {
      "type": "string"
    },
    "verification_type": {
      "type": "string"
    },
    "issuance_date": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string"
    },
    "age_birth_year": {
      "type": "string"
    },
    "age_over_18": {
      "type": "string"
