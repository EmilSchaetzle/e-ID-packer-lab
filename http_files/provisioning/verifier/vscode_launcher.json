{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Verifier",
            "request": "launch",
            "mainClass": "ch.admin.bj.swiyu.verifier.Application",
            "projectName": "swiyu-verifier-application",
            "cwd": "${workspaceFolder}",
            "vmArgs": "-Dspring.profiles.active=local  -Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts -Djavax.net.ssl.trustStorePassword=changeit "
        }
    ]
}
